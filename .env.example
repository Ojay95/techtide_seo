# Formspree form ID (the part after /f/ in your form endpoint)
PUBLIC_FORMSPREE_ID=
# Admin (Keystatic) in production: your GitHub repo as OWNER/REPO
PUBLIC_KEYSTATIC_REPO=
# Created by Keystatic's GitHub app setup (see README)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Optional analytics (load only after the visitor accepts cookies). Leave empty to disable the cookie banner.
PUBLIC_GA_ID=
PUBLIC_CLARITY_ID=
# Optional booking link (Cal.com, Calendly) shown on the Contact page
PUBLIC_BOOKING_URL=
