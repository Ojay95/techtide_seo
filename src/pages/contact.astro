---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../data/site';
const booking = import.meta.env.PUBLIC_BOOKING_URL;
---
<Base title="Contact TechTide SEO" description="Contact TechTide SEO or book a discovery call to talk about your search goals. We reply within [X] business days.">
  <section class="gridbg" style="padding:72px 0"><div class="w two" style="align-items:start">
    <div>
      <nav class="mono crumb" aria-label="Breadcrumb"><a href="/">Home</a> / Contact</nav>
      <h1 class="h1" style="font-size:clamp(34px,4.6vw,50px);margin-top:14px">Let's talk about <span class="acc">your goals</span></h1>
      <p class="m lead">Send a message or book a call. We reply within [X] business days.</p>
      {booking && <p><a class="btn" href={booking}>Book a discovery call</a></p>}
      <p class="m">Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />Office: {SITE.address}</p>
      <p class="m">Looking for a quick review of your site? <a href="/free-seo-audit/">Get a free SEO audit</a>.</p>
    </div>
    <div class="p" style="padding:28px"><ContactForm /></div>
  </div></section>
</Base>
