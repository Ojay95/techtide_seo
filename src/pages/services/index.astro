---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { SERVICES } from '../../data/services';
import { SITE } from '../../data/site';
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
  { '@type': 'ListItem', position: 2, name: 'Services' }] };
---
<Base title="SEO Services: Local, Technical, On-Page | TechTide SEO" description="Explore TechTide SEO's services: local SEO, technical SEO, on-page SEO, content, link building and audits. Plans from $500 per month." schema={[crumbs]}>
  <section class="gridbg" style="padding:72px 0"><div class="w"><nav class="mono crumb" aria-label="Breadcrumb"><a href="/">Home</a> / Services</nav><h1 class="h1" style="max-width:780px">SEO services built around your goals</h1><p class="m lead">Every business needs a different mix. We start with an audit, then build a plan from the services below.</p></div></section>
  <section class="sec"><div class="w grid">{SERVICES.map((s, i) => <div class="p"><div class="mono">0{i + 1}</div><h3>{s.name}</h3><p class="m">{s.short}</p><p style="margin-top:10px"><a href={`/services/${s.slug}/`} style="font-weight:700;text-decoration:none">Learn more →</a></p></div>)}</div></section>
  <CTA heading="Not sure where to start?" />
</Base>
