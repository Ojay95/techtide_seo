---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Visual from '../../components/Visual.astro';
import { SERVICES } from '../../data/services';
import { SITE } from '../../data/site';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const visual: Record<string, string> = { 'local-seo': 'heat', 'technical-seo': 'tech', 'on-page-seo': 'serp', 'content-seo': 'bars', 'link-building': 'net', 'seo-audit': 'chart' };
const pricing: Record<string, { from: string; unit: string; included: string[] }> = {
  'local-seo': { from: '$500', unit: '/ month', included: ['Google Business Profile management', 'Citation cleanup', 'Review system', 'Core on-page fixes', 'Monthly report'] },
  'seo-audit': { from: '$500', unit: 'one time', included: ['Technical and on-page review', 'Content and keyword gaps', 'Local and link review', 'Prioritised action plan', 'Walkthrough call'] },
};
const price = pricing[s.slug];
const live = new Set((await getCollection('guides')).filter((g) => !g.data.draft).map((g) => `/guides/${g.id}/`));
const related = s.related.filter(([href]) => live.has(href));
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.name, description: s.metaDescription, url: `${SITE.url}/services/${s.slug}/`, provider: { '@type': 'Organization', name: SITE.name, url: SITE.url } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
    { '@type': 'ListItem', position: 3, name: s.name }] },
];
---
<Base title={s.metaTitle} description={s.metaDescription} schema={schema}>
  <section class="gridbg" style="padding:72px 0"><div class="w two">
    <div>
      <nav class="mono crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services/">Services</a> / {s.name}</nav>
      <h1 class="h1" style="font-size:clamp(34px,4.8vw,54px);margin-top:14px">{s.h1}</h1>
      <p class="m lead">{s.intro}</p>
      <a class="btn" href="/free-seo-audit/">Get your free SEO audit</a>
    </div>
    <div class="p" role="group" aria-label="Illustrative sample visual"><div style="display:flex;justify-content:space-between;margin-bottom:14px"><span class="mono">{s.name}</span><span class="pill">Sample data</span></div><Visual kind={visual[s.slug]} /></div>
  </div></section>
  <section class="sec"><div class="w"><div class="mono">What we do</div><h2 class="h2">{s.items.length} parts of {s.name.toLowerCase()}</h2>
    <div class="grid" style="margin-top:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))">{s.items.map(([a, b], i) => <div class="p"><div class="mono">0{i + 1}</div><h3>{a}</h3><p class="m">{b}</p></div>)}</div></div></section>
  <section class="sec alt"><div class="w grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))"><div class="p"><div class="mono">{s.resultTitle}</div><p style="font-size:18px;margin-top:10px">{s.resultText}</p></div>{s.extraTitle && <div class="p"><div class="mono">{s.extraTitle}</div><p style="font-size:18px;margin-top:10px">{s.extraText}</p></div>}</div></section>
  {price && <section class="sec"><div class="w"><div class="p two" style="padding:36px;border-color:var(--accent)">
    <div><div class="mono">Pricing</div><div style="font:800 52px 'Sora Variable',sans-serif;margin:8px 0">from {price.from}<span class="m" style="font-size:20px;font-weight:400"> {price.unit}</span></div><p class="m" style="margin:0 0 20px">The final price depends on your market and goals.</p><a class="btn" href="/free-seo-audit/">Get your free SEO audit</a></div>
    <div><div class="mono">Included</div><ul class="ul">{price.included.map((i) => <li>{i}</li>)}</ul></div></div></div></section>}
  {related.length > 0 && <section class="sec alt"><div class="w"><div class="mono">Related guides</div><div class="grid" style="margin-top:16px">{related.map(([href, label]) => <a class="p" href={href} style="text-decoration:none;color:var(--text)"><h3>{label}</h3></a>)}</div></div></section>}
  <CTA />
</Base>
