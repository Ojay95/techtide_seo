---
// Blog page 1 (/blog/). Pages 2+ are generated by [page].astro.
import BlogListing from '../../components/BlogListing.astro';
import { getSortedPosts, PAGE_SIZE } from '../../lib/blogPages';

const posts = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---
<BlogListing items={posts.slice(0, PAGE_SIZE)} current={1} totalPages={totalPages} total={posts.length} />
