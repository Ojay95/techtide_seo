---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import ContentList from '../../components/ContentList.astro';
import { getCollection } from 'astro:content';
const when = (e: any) => (e.data.published ?? e.data.updated).valueOf();
const items = (await getCollection('blog')).filter((e) => !e.data.draft).sort((a, b) => when(b) - when(a));
---
<Base title="SEO Blog | TechTide SEO" description="Long-form SEO articles from TechTide SEO: practical how-tos on keyword research, local SEO, Core Web Vitals, schema, links and more.">
  <section class="gridbg" style="padding:72px 0"><div class="w"><nav class="mono crumb" aria-label="Breadcrumb"><a href="/">Home</a> / Blog</nav><h1 class="h1" style="max-width:780px">The TechTide SEO <span class="acc">blog</span></h1><p class="m lead">Long-form, practical articles on getting found on Google. Want step-by-step checklists? See our <a href="/guides/">guides</a>.</p><div class="mono m">{items.length} articles</div></div></section>
  <ContentList items={items} kind="blog" featured />
  <CTA />
</Base>
