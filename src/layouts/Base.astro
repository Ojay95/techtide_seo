---
import '@fontsource-variable/sora';
import '@fontsource-variable/dm-sans';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import LeadPopup from '../components/LeadPopup.astro';
import { SITE, NAV } from '../data/site';

const { title, description, schema = [], noindex = false, image = '/images/og-default.jpg' } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
   const org = {
     '@context': 'https://schema.org', '@type': ['Organization', 'ProfessionalService'], '@id': `${SITE.url}/#organization`,
     name: SITE.name, url: SITE.url, logo: `${SITE.url}/favicon.svg`, email: SITE.email,
     description: 'TechTide SEO is an SEO agency based in Ikeja, Lagos, Nigeria, helping businesses in Nigeria and worldwide get found on Google.',
     address: { '@type': 'PostalAddress', streetAddress: SITE.street, addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: SITE.country },
     areaServed: ['Nigeria', 'Worldwide'],
     knowsAbout: ['Search engine optimisation', 'Local SEO', 'Technical SEO', 'On-page SEO', 'Content marketing', 'Link building'],
     ...(SITE.sameAs.length ? { sameAs: SITE.sameAs } : {}),
   };
   const base: any[] = [org, { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url }];
   // Auto-generate BreadcrumbList for every non-home page unless the page already provides one.
   const segs = path.split('/').filter(Boolean);
   const hasCrumbs = schema.some((s: any) => s['@type'] === 'BreadcrumbList');
   if (segs.length && !noindex && !hasCrumbs) {
     const label = (href: string, seg: string) => NAV.find((n) => n.href === href)?.label ?? seg.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()).replace(/\bseo\b/gi, 'SEO');
     const items = [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }];
     segs.forEach((seg, i) => {
       const href = `/${segs.slice(0, i + 1).join('/')}/`;
       const last = i === segs.length - 1;
       items.push({ '@type': 'ListItem', position: i + 2, name: last ? String(title).split(' | ')[0] : label(href, seg), item: `${SITE.url}${href}` });
     });
     base.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items });
   }
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () { var t = 'light'; try { t = localStorage.getItem('theme') || 'light'; } catch (e) {} document.documentElement.dataset.theme = t; })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TechTide SEO: Get found on Google" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {[...base, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var n = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = n;
        try { localStorage.setItem('theme', n); } catch (e) {}
      });
    </script>
    <ConsentBanner />
    <LeadPopup />
    <script>
      document.querySelectorAll<HTMLFormElement>('form.audit-form').forEach((f) => {
        f.addEventListener('submit', async (e) => {
          e.preventDefault();
          const s = f.querySelector('.status') as HTMLElement;
          const b = f.querySelector('button[type=submit]') as HTMLButtonElement;
          if (f.dataset.ready !== 'yes') { s.textContent = 'This form is not connected yet.'; return; }
          b.disabled = true; s.textContent = 'Sending…';
          try {
            const r = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
            if (r.ok) {
              f.reset();
              // Show confirmation with a clickable link to the checklist
              if (f.closest('#lead-popup')) {
                var s = f.querySelector('.status');
                if (s) {
                  s.innerHTML = '✓ Subscribed! <a href="/seo-checklist.html" target="_blank" style="color:var(--teal);font-weight:700">Open your checklist →</a>';
                }
                setTimeout(function () {
                  var d = document.getElementById('lead-popup');
                  if (d && d.open) d.close();
                }, 4000);
              } else {
                var s2 = f.querySelector('.status');
                if (s2) s2.textContent = f.dataset.done || 'Thank you. We have your details.';
              }
            }
            else { s.textContent = 'Something went wrong. Please try again.'; }
          } catch { s.textContent = 'Network error. Please try again.'; }
          b.disabled = false;
        });
      });
    </script>
  </body>
</html>
