---
import Base from './Base.astro';
import CTA from '../components/CTA.astro';
import { render, getCollection } from 'astro:content';
import { SITE } from '../data/site';

const { entry, kind } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h: any) => h.depth === 2);
const d = entry.data;
const pub = d.published ?? d.updated;
const section = kind === 'guides' ? 'guides' : 'blog';
const url = `${SITE.url}/${section}/${entry.id}/`;
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
const more = (await getCollection(kind)).filter((e: any) => !e.data.draft && e.id !== entry.id).slice(0, 2);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, datePublished: pub.toISOString(), dateModified: d.updated.toISOString(),
    author: { '@type': 'Organization', name: SITE.name }, publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url }, mainEntityOfPage: url },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: kind === 'guides' ? 'Guides' : 'Blog', item: `${SITE.url}/${section}/` },
    { '@type': 'ListItem', position: 3, name: d.title }] },
];
---
<Base title={d.metaTitle ?? `${d.title} | ${SITE.name}`} description={d.description} schema={schema}>
  <section class="gridbg" style="padding:56px 0 44px"><div class="w">
    <nav class="mono crumb" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={`/${section}/`}>{kind === 'guides' ? 'Guides' : 'Blog'}</a> / {d.category}</nav>
    <h1 class="h1" style="font-size:clamp(32px,4.6vw,52px);max-width:820px;margin:14px 0">{d.title}</h1>
    <div class="mono m">By the TechTide SEO team · Published {fmt(pub)}{pub.valueOf() !== d.updated.valueOf() ? ` · Updated ${fmt(d.updated)}` : ''} · {minutes} min read</div>
  </div></section>
  <section class="sec" style="padding-top:48px"><div class="w art">
    <aside aria-label="Table of contents"><div class="p toc" style="position:sticky;top:16px"><div class="mono" style="margin-bottom:6px">In this {kind === 'guides' ? 'guide' : 'post'}</div>{toc.map((h: any) => <a href={`#${h.slug}`}>{h.text}</a>)}</div></aside>
    <article>
      <div class="p" style="border:2px solid var(--accent);margin-bottom:32px;max-width:720px"><div class="mono">In short</div><p style="margin:8px 0 0;font-size:18px">{d.description}</p></div>
      <div class="prose"><Content /></div>
      <div class="p" style="margin-top:40px;max-width:720px;border-color:var(--accent)"><div class="mono">Want this done for you?</div><p class="m" style="margin:8px 0 18px">See how our SEO services work, or start with a free audit.</p><a class="btn" href="/services/">See our services</a><a class="btn ghost" href="/free-seo-audit/">Free SEO audit</a></div>
      {more.length > 0 && <div style="margin-top:44px;max-width:720px"><div class="mono">Keep reading</div><div class="grid" style="margin-top:14px">{more.map((e: any) => <a class="p" href={`/${section}/${e.id}/`} style="text-decoration:none;color:var(--text)"><h3 style="font-size:18px">{e.data.title}</h3></a>)}</div></div>}
    </article>
  </div></section>
</Base>
